# Contact form delivery. Without RESEND_API_KEY the form validates and then
# reports that it could not send, offering the direct email address — it never
# silently discards a message.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend. Falls back to Resend's
# shared onboarding sender, which is fine for testing and not for production.
CONTACT_FROM_EMAIL=
